# Idea Pipeline - Environment Variables
# Copy this file to .env and fill in your API keys

# News API (https://newsapi.ai, aka EventRegistry)
# Sign up for a free account to get your API key
NEWSAPI_API_KEY=your_newsapi_key_here
NEWSAPI_TOPIC_URI=your_newsapi_topic_uri_here

# Google Gemini (https://aistudio.google.com/apikey)
# Create an API key in Google AI Studio
GEMINI_API_KEY=your_gemini_key_here

# LLM provider for the text steps: google (default) or lmstudio (experimental).
# Image generation, TTS and embeddings always use Gemini.
# Can also be set per run with: uv run idea-pipeline run --provider lmstudio
#LLM_PROVIDER=google
#LMSTUDIO_BASE_URL=http://localhost:1234/v1
#LMSTUDIO_API_KEY=lm-studio
